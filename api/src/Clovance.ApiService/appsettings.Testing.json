{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 100,
      "WindowSeconds": 300
    }
  },
  "ForwardedHeaders": {
    "Enabled": true
  },
  "Identity": {
    "RefreshTokens": {
      "Cleanup": {
        "Enabled": false,
        "IntervalHours": 24,
        "BatchSize": 500,
        "UsedRetentionHours": 48
      }
    }
  },
  "Jwt": {
    "KeyFilePath": "/home/app/jwt.key",
    "Issuer": "Clovance.Api",
    "Audience": "Clovance.Client",
    "ExpirationMinutes": 15
  }
}