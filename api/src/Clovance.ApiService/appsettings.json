{
  "ConnectionStrings": {
    "clovance-database": "Host=localhost;Port=5432;Database=database;Username=postgres;Password=postgres"
  },
  "Identity": {
    "Invitations": {
      "ExpirationHours": 48
    },
    "PasswordReset": {
      "ExpirationMinutes": 30
    },
    "RefreshTokens": {
      "Cleanup": {
        "Enabled": true,
        "IntervalHours": 24,
        "BatchSize": 500,
        "UsedRetentionHours": 48
      }
    }
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "Clovance",
    "UseStartTls": true
  },
  "Frontend": {
    "BaseUrl": "http://localhost:7000"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "Auth": {
      "Enabled": true,
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Jwt": {
    "KeyFilePath": "/home/app/jwt.key",
    "Issuer": "Clovance.Api",
    "Audience": "Clovance.Client",
    "ExpirationMinutes": 15
  }
}
