{
  "ConnectionStrings": {
    "clovance-database": "Host=localhost;Port=5432;Database=database;Username=postgres;Password=postgres"
  },
  "Identity": {
    "Invitations": {
      "ExpirationHours": 48
    },
    "RefreshTokens": {
      "Cleanup": {
        "Enabled": true,
        "IntervalHours": 24,
        "BatchSize": 500,
        "UsedRetentionHours": 48
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "KeyFilePath": "/home/app/jwt.key",
    "Issuer": "Clovance.Api",
    "Audience": "Clovance.Client",
    "ExpirationMinutes": 60
  }
}
